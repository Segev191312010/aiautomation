# PAPER-only operator template. Copy to a private .env file; never commit secrets.
AUTOPILOT_MODE=PAPER
IS_PAPER=true
SIM_MODE=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
CLAUDE_WORKER_ENABLED=true
TV_WEBHOOK_SECRET=
TV_IP_STRICT=true
TV_ALLOWED_IPS=
METRICS_EXPOSURE_PROFILE=isolated

# Keep the runtime database on the canonical backend path.
DB_PATH=/absolute/path/to/backend/trading_bot.db
