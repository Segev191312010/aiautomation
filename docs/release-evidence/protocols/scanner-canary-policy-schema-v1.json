{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradebot://scanner-canary-policy-schema-v1",
  "title": "ScannerCanaryPolicyV1 pre-T schema and immutable safety envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "owner", "risk_operator", "limits", "runtime", "signed_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^scanner-canary-v1-[a-z0-9-]+$"},
    "owner": {"type": "string", "minLength": 1},
    "risk_operator": {"type": "string", "minLength": 1},
    "signed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["symbols", "max_order_quantity", "max_order_notional", "max_daily_notional", "max_entry_orders", "max_entry_adapter_calls", "max_cumulative_filled_quantity", "max_cumulative_filled_notional", "max_open_positions", "daily_loss_limit", "no_short", "cancel_timeout_seconds", "observation_seconds", "max_rollback_seconds"],
      "properties": {
        "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9.:-]+$"}},
        "max_order_quantity": {"type": "integer", "minimum": 1},
        "max_order_notional": {"type": "number", "exclusiveMinimum": 0},
        "max_daily_notional": {"type": "number", "exclusiveMinimum": 0},
        "max_entry_orders": {"const": 1},
        "max_entry_adapter_calls": {"const": 1},
        "max_cumulative_filled_quantity": {"type": "integer", "minimum": 1},
        "max_cumulative_filled_notional": {"type": "number", "exclusiveMinimum": 0},
        "max_open_positions": {"type": "integer", "minimum": 1},
        "daily_loss_limit": {"type": "number", "exclusiveMinimum": 0},
        "no_short": {"const": true},
        "cancel_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "observation_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_rollback_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["workers", "sim_mode", "claude_worker", "claude_live", "tv_write_route", "mcp_order_tool"],
      "properties": {
        "workers": {"const": 1}, "sim_mode": {"type": "boolean"},
        "claude_worker": {"const": false}, "claude_live": {"const": false},
        "tv_write_route": {"const": false}, "mcp_order_tool": {"const": false}
      }
    }
  }
}
