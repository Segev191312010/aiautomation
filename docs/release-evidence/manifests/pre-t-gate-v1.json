{
  "schema_version": 1,
  "name": "pre-t-gate-v1",
  "description": "Complete, fail-closed evidence index for candidate T. Every file and command is mandatory.",
  "required_files": [
    "backend/requirements.lock",
    "dashboard/package-lock.json",
    "docker-compose.test.yml",
    "docs/release-evidence/manifests/toolchain-lock-v1.json",
    "docs/release-evidence/manifests/dependency-risk-acceptance-v1.json",
    "docs/release-evidence/manifests/signing-trust-v1.json",
    "docs/release-evidence/manifests/broker-call-inventory-v1.json",
    "docs/release-evidence/manifests/runtime-file-manifest-v1.json",
    "docs/release-evidence/manifests/canary-fence-design-v1.json",
    "docs/release-evidence/manifests/phase-c-process-artifacts-v1.json",
    "docs/release-evidence/manifests/test-outcome-allowlist-v1.json",
    "docs/release-evidence/schemas/scanner-chain-v1.schema.json",
    "docs/release-evidence/manifests/canary-hard-limits-v1.json",
    "scripts/build_sign_verify_oci.sh",
    "scripts/verify_authority_inputs.py",
    "scripts/verify_release_signature.py",
    "scripts/check_phase_c_process_artifacts.py",
    "scripts/verify_test_outcomes.py",
    "backend/tests/test_canary_fence_conformance.py",
    "backend/tests/test_restore_generation_fence.py"
  ],
  "checks": [
    {"name": "toolchain", "argv": ["python", "scripts/verify_toolchain.py", "--repo-root", "{repo_root}", "--manifest", "docs/release-evidence/manifests/toolchain-lock-v1.json"]},
    {"name": "authority-inputs", "argv": ["python", "scripts/verify_authority_inputs.py", "--repo-root", "{repo_root}"]},
    {"name": "broker-call-inventory", "argv": ["python", "scripts/verify_broker_call_inventory.py", "--repo-root", "{repo_root}", "--manifest", "docs/release-evidence/manifests/broker-call-inventory-v1.json"]},
    {"name": "runtime-file-manifest", "argv": ["python", "scripts/verify_runtime_file_manifest.py", "--repo-root", "{repo_root}", "--manifest", "docs/release-evidence/manifests/runtime-file-manifest-v1.json"]},
    {"name": "canary-fence-design", "argv": ["python", "scripts/verify_canary_fence_design.py", "docs/release-evidence/manifests/canary-fence-design-v1.json"]},
    {"name": "scanner-chain", "argv": ["python", "scripts/verify_scanner_chain.py", "--repo-root", "{repo_root}", "--phase", "paper-startup"]},
    {"name": "compose-smoke", "argv": ["scripts/run_compose_smoke.sh"], "env": {"CANDIDATE_SHA": "{candidate}"}},
    {"name": "oci-provenance", "argv": ["scripts/build_sign_verify_oci.sh", "--candidate", "{candidate}", "--evidence", "docs/release-evidence/build/oci-build-v1.json"]},
    {"name": "phase-c-process", "argv": ["python", "scripts/check_phase_c_process_artifacts.py", "--manifest", "docs/release-evidence/manifests/phase-c-process-artifacts-v1.json", "--candidate", "{candidate}"]},
    {"name": "restore-fence-conformance", "argv": ["python", "-m", "pytest", "backend/tests/test_canary_fence_conformance.py", "backend/tests/test_restore_generation_fence.py", "-q", "-p", "no:cacheprovider"]}
  ]
}
